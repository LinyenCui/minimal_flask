                        if not trip_info:
                            print(f"[{now}] 找不到班次 #{trip_id}，可能已被刪除")
                            error_count += 1
                            continue
                        
                        # 如果班次狀態不是"準備"，跳過
                        if trip_info[10] != '準備':
                            print(f"[{now}] 班次 #{trip_id} 狀態為「{trip_info[10]}」，不是「準備」，跳過更新")
                            skipped_count += 1
                            continue
                        
