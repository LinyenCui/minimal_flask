    if message_text == "顯示主菜單" or message_text == "主菜單":
        # 使用現有的 get_help_flex_page2 函數
        help_bubble = get_help_flex_page2()
        flex_message = FlexMessage(alt_text="可用命令列表", contents=help_bubble)
        messaging_api.reply_message(
            ReplyMessageRequest(
                reply_token=reply_token,
                messages=[flex_message]
            )
        )
        return
    
    # 處理更多命令菜單 - 暫時移除，因為我們只使用一個菜單
    
    # 檢查用戶是否在預約流程中（使用新的Flex Message預約功能）
    from handle_booking_flex import booking_states
    if user_id in booking_states:
        try:
            response = handle_booking_message(user_id, message_text)
            if response:
                # 檢查返回的消息類型
                if isinstance(response, dict) and "type" in response and response["type"] == "text":
                    # 文本消息
                    messaging_api.reply_message(
                        ReplyMessageRequest(
                            reply_token=reply_token,
                            messages=[TextMessage(text=response["text"])]
                        )
                    )
                elif isinstance(response, TextMessage):
                    # 這是TextMessage對象
                    messaging_api.reply_message(
                        ReplyMessageRequest(
                            reply_token=reply_token,
                            messages=[response]
                        )
                    )
                elif isinstance(response, FlexMessage):
                    # 這是FlexMessage對象
                    messaging_api.reply_message(
                        ReplyMessageRequest(
                            reply_token=reply_token,
                            messages=[response]
                        )
                    )
                else:
                    # 將返回值轉換為文本消息
                    print(f"未知的響應類型: {type(response)}, 內容: {response}")
                    try:
                        if isinstance(response, str):
                            text_message = response
                        else:
                            text_message = str(response)
                        
                        messaging_api.reply_message(
                            ReplyMessageRequest(
                                reply_token=reply_token,
                                messages=[TextMessage(text=text_message)]
                            )
                        )
                    except Exception as e:
                        print(f"轉換響應為文本時出錯: {e}")
