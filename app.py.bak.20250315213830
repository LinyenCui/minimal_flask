def initialize_unique_codes():
    """初始化所有沒有唯一識別碼的班次"""
    try:
        print(f"[{datetime.now()}] 開始初始化班次唯一識別碼...")
        
        # 使用應用上下文和DB_ENGINE進行數據庫操作
        with current_app.app_context():
            engine = current_app.config['DB_ENGINE']
            with engine.connect() as conn:
                # 開始事務
                trans = conn.begin()
                try:
                    # 查詢所有沒有唯一識別碼的班次
                    query = """
                    SELECT 
                        trip_id, 
                        date, 
                        fixed_trip_id
                    FROM 
                        trips
                    WHERE 
                        unique_code IS NULL
                    """
                    
                    trips = conn.execute(sql_text(query)).fetchall()
                    print(f"[{datetime.now()}] 找到 {len(trips)} 個沒有唯一識別碼的班次")
                    
                    # 為每個班次生成並更新唯一識別碼
                    updated_trips_count = 0
                    for trip in trips:
                        try:
                            trip_id = trip[0]
                            date_obj = trip[1]
                            fixed_trip_id = trip[2]
                            
                            if not date_obj:
                                print(f"[{datetime.now()}] 班次 #{trip_id} 沒有日期信息，無法生成唯一識別碼")
                                continue
                            
                            # 計算一年中的第幾天和第幾周
                            day_of_year = date_obj.timetuple().tm_yday
                            _, week_number, _ = date_obj.isocalendar()
                            
                            # 生成唯一識別碼
                            if fixed_trip_id:
                                unique_code = f"{fixed_trip_id}_{day_of_year}_{week_number}"
                                print(f"[{datetime.now()}] 班次 #{trip_id} 是固定班次 (ID: {fixed_trip_id})，生成唯一識別碼: {unique_code}")
                            else:
                                unique_code = f"T_{trip_id}"
                                print(f"[{datetime.now()}] 班次 #{trip_id} 是臨時班次，生成唯一識別碼: {unique_code}")
                            
                            # 更新班次的唯一識別碼和週數
                            update_query = """
                            UPDATE trips 
                            SET unique_code = :unique_code, week_number = :week_number
                            WHERE trip_id = :trip_id
                            """
                            
                            conn.execute(
                                sql_text(update_query), 
                                {
                                    "unique_code": unique_code,
                                    "week_number": week_number,
                                    "trip_id": trip_id
                                }
                            )
                            updated_trips_count += 1
                            print(f"[{datetime.now()}] 成功更新班次 #{trip_id} 的唯一識別碼為 {unique_code}")
                        except Exception as e:
                            print(f"[{datetime.now()}] 更新班次 #{trip_id} 的唯一識別碼時出錯: {e}")
                            import traceback
                            print(traceback.format_exc())
                    
                    # 查詢所有沒有唯一識別碼的已完成班次
                    completed_query = """
                    SELECT 
                        id, 
                        date
                    FROM 
                        completed_trips
                    WHERE 
                        unique_code IS NULL
                    """
                    
                    completed_trips = conn.execute(sql_text(completed_query)).fetchall()
                    print(f"[{datetime.now()}] 找到 {len(completed_trips)} 個沒有唯一識別碼的已完成班次")
                    
                    # 為每個已完成班次生成並更新唯一識別碼
                    updated_completed_count = 0
                    for trip in completed_trips:
                        try:
                            trip_id = trip[0]
                            
                            # 生成唯一識別碼（臨時班次）
                            unique_code = f"C_{trip_id}"
                            print(f"[{datetime.now()}] 已完成班次 #{trip_id} 生成唯一識別碼: {unique_code}")
                            
                            # 更新已完成班次的唯一識別碼
                            update_query = """
                            UPDATE completed_trips 
                            SET unique_code = :unique_code 
                            WHERE id = :id
                            """
                            
                            conn.execute(
                                sql_text(update_query), 
                                {
                                    "unique_code": unique_code,
                                    "id": trip_id
                                }
                            )
                            updated_completed_count += 1
                            print(f"[{datetime.now()}] 成功更新已完成班次 #{trip_id} 的唯一識別碼為 {unique_code}")
                        except Exception as e:
                            print(f"[{datetime.now()}] 更新已完成班次 #{trip_id} 的唯一識別碼時出錯: {e}")
                            import traceback
                            print(traceback.format_exc())
                    
                    # 提交事務
                    trans.commit()
                    print(f"[{datetime.now()}] 成功提交所有更新")
                    
                    print(f"[{datetime.now()}] 初始化班次唯一識別碼任務結束。成功更新班次: {updated_trips_count}, 已完成班次: {updated_completed_count}")
                    return f"✅ 成功初始化 {updated_trips_count} 筆班次和 {updated_completed_count} 筆已完成班次的唯一識別碼。"
                    
                except Exception as e:
                    # 發生錯誤時回滾事務
                    trans.rollback()
                    print(f"[{datetime.now()}] 初始化班次唯一識別碼時出錯，已回滾: {e}")
                    import traceback
                    print(traceback.format_exc())
                    raise
        
    except Exception as e:
        print(f"[{datetime.now()}] 初始化班次唯一識別碼任務失敗: {e}")
        import traceback
        print(traceback.format_exc())
        error_msg = f"初始化唯一識別碼失敗: {str(e)}"
        return error_msg

