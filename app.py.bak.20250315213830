@app.route("/callback", methods=['POST'])
def callback():
    # 獲取 X-Line-Signature 請求頭
    signature = request.headers['X-Line-Signature']
    
    # 獲取請求體
    body = request.get_data(as_text=True)
    app.logger.info("Request body: " + body)
    
    # 處理 webhook 請求
    try:
        events = parser.parse(body, signature)
        for event in events:
            # 檢查是否是文本消息
            if event.type == "message" and event.message.type == "text":
                message_text = event.message.text
                source_type = event.source.type
                
                # 如果是群組消息，檢查是否有@機器人
                if source_type == 'group' or source_type == 'room':
                    # 獲取機器人的LINE ID（通常是@開頭的ID）
                    bot_id = os.environ.get('LINE_BOT_ID', 'Linyan')  # 使用環境變量或默認值
                    
                    # 檢查消息中是否@了機器人
                    # 注意：LINE可能會將@username轉換為不同的格式，所以我們需要檢查多種可能
                    is_mentioned = False
                    
                    # 檢查常見的@格式
                    if f"@{bot_id}" in message_text or f"＠{bot_id}" in message_text:
                        is_mentioned = True
                    
                    # 有些LINE客戶端可能會添加不可見字符，所以我們也檢查消息是否以@開頭
                    elif message_text.lstrip().startswith(f"@{bot_id}") or message_text.lstrip().startswith(f"＠{bot_id}"):
                        is_mentioned = True
                    
                    # 如果沒有被@，則不處理
                    if not is_mentioned:
                        continue
                    
                    # 被@了，去除@部分
                    message_text = re.sub(r'@\S+\s*', '', message_text).strip()
                    message_text = re.sub(r'＠\S+\s*', '', message_text).strip()
                    
                    # 如果去除@後消息為空，則不處理
                    if not message_text:
                        continue
                    
                    # 更新event.message.text為處理後的文本
                    event.message.text = message_text
                
                # 處理消息
                handle_text_message(event)
    except InvalidSignatureError:
        abort(400)
    except Exception as e:
        print(f"發生錯誤: {e}")
        abort(500)

    return 'OK'
