def handle_clear_all_trips():
    try:
        # 先將所有已完成的班次複製到completed_trips表
        copy_query = """
        INSERT INTO completed_trips 
        (date, start_point, via_point, end_point, meter_fare, extra_fare, category, driver_id) 
        SELECT 
            date, 
            start_point, 
            via_point, 
            end_point, 
            meter_fare, 
            extra_fare, 
            category, 
            driver_id 
        FROM 
            trips 
        WHERE 
            status = '已完成'
            AND trip_id NOT IN (
                SELECT trip_id FROM completed_trips WHERE trip_id IS NOT NULL
            )
        """
        
        db.session.execute(sql_text(copy_query))
        
        # 獲取已完成班次的數量
        completed_count_query = """
        SELECT COUNT(*) FROM trips WHERE status = '已完成'
        """
        
        completed_count = db.session.execute(sql_text(completed_count_query)).fetchone()[0]
        
        # 刪除所有班次
        delete_query = "DELETE FROM trips"
        db.session.execute(sql_text(delete_query))
        
        db.session.commit()
        
        return f"✅ 已清除所有班次。{completed_count} 筆已完成班次已複製到已完成班次資料表。"
        
    except Exception as e:
