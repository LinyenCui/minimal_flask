def handle_change_status(message_text):
    try:
        # 解析參數
        parts = message_text.split()
        if len(parts) < 3:
            return "更改狀態命令格式不正確。正確格式：更改狀態 [班次ID] [新狀態]"
        
        trip_id = int(parts[1])
        new_status = parts[2]
        
        # 檢查狀態是否有效
        valid_statuses = ["準備", "完成", "取消", "衝突", "請假"]
        if new_status not in valid_statuses:
            return f"無效的狀態。有效狀態包括：{', '.join(valid_statuses)}"
        
        
        # 檢查班次是否存在
        check_query = "SELECT trip_id, status FROM trips WHERE trip_id = :trip_id"
        trip = db.session.execute(sql_text(check_query), {"trip_id": trip_id}).fetchone()
        
        if not trip:
            return f"找不到ID為 {trip_id} 的班次。"
        
        # 更新班次狀態
        update_query = """
        UPDATE trips 
        SET status = :status 
        WHERE trip_id = :trip_id
        """
        
        db.session.execute(
            sql_text(update_query), 
            {
                "status": new_status,
                "trip_id": trip_id
            }
        )
        db.session.commit()
        
        return f"✅ 已成功將班次 {trip_id} 的狀態更改為 '{new_status}'。"
        
    except ValueError:
        return "班次ID必須是數字。"
    except Exception as e:
        # 發生錯誤時回滾事務
        db.session.rollback()
        return f"更改狀態失敗: {str(e)}"

