# 在 handle_text_message 函數中更新命令處理部分
    # 根據不同的命令執行不同的操作
    if message_text == "查詢班次":
        logger.info("執行查詢班次命令")
        try:
            reply_text = trip_handler.handle_query_trips()
        except Exception as e:
            logger.error(f"查詢班次錯誤: {str(e)}")
            reply_text = f"查詢班次功能尚未實現。錯誤: {str(e)}"
    elif message_text == "待派班次":
        logger.info("執行待派班次命令")
        try:
            reply_text = trip_handler.handle_pending_trips()
        except Exception as e:
            logger.error(f"待派班次錯誤: {str(e)}")
            reply_text = f"待派班次功能尚未實現。錯誤: {str(e)}"
    elif message_text.startswith("指派"):
        logger.info("執行指派司機命令")
        try:
            reply_text = driver_handler.handle_assign_driver(message_text)
        except Exception as e:
            logger.error(f"指派司機錯誤: {str(e)}")
            reply_text = f"指派司機功能尚未實現。錯誤: {str(e)}"
    elif message_text == "幫助":
        logger.info("執行幫助命令")
        reply_text = get_help_text()
    else:
        # 簡單的回覆邏輯
        logger.info("執行默認回覆")
        reply_text = get_default_reply(message_text)
    return reply_text 