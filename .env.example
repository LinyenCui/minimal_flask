# ============================================================
# LINE Bot 環境變數範例
#
# 載入邏輯（app.py 處理）：
#   - Render 平台會注入 RENDER=true → 用 Render dashboard 環境變數，跳過 .env
#   - 本地有 .env.dev → .env (base) + .env.dev (override)
#                       適合 dev：dev LINE channel + 本地 DB + dev LIFF
#   - 本地只有 .env → 直接載 .env
# ============================================================

# === LINE Messaging API（每個環境一組）===
LINE_CHANNEL_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret

# === LIFF（LINE Login Channel + LIFF App）===
# LIFF_ID 格式：{login_channel_id}-{liff_app_random}（即 LINE Console 顯示的 LIFF ID）
# LIFF_CHANNEL_ID 是 LINE Login Channel ID（純數字 10 位，等於 LIFF_ID 的前半段）
# 兩個一起用做 LIFF idToken JWT 驗證（rewrite/handlers/liff/auth.py）
LIFF_ID=2010000000-xxxxxxxx
LIFF_CHANNEL_ID=2010000000

# === 資料庫 ===
# 主程式用（統一 psycopg 驅動）
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/dbname

# scripts/sync_from_render.py 用（從本地連 Render DB 拉資料）
RENDER_DB_HOST=dpg-xxx-singapore-postgres.render.com
RENDER_DB_USER=your_render_db_user
RENDER_DB_NAME=your_render_db_name
RENDER_DB_PASSWORD=your_render_db_password

# === Google Cloud / Vertex AI（Gemini 2.5 Flash）===
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# === 排程告警（可選）===
# 排程任務（班次自動完成）失敗時 push 告警的目標 LINE chat ID
#（user_id / group_id / room_id 皆可）。未設定 = 不發告警，只寫 log。
# 注意：push 計入 LINE 月額度，且受 PUSH_NOTIFY 總開關控制。
LINE_ADMIN_CHAT_ID=

# === 伺服器（可選）===
PORT=3000
TZ=Asia/Taipei
