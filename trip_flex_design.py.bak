"""
此模塊包含班次詳情的 Flex Message 設計
"""

def get_trip_details_flex(trip_id, trip_data):
    """
    生成班次詳情的 Flex Message
    
    參數:
        trip_id: 班次ID
        trip_data: 班次數據字典，包含以下鍵:
            - date: 日期
            - time: 時間
            - start_point: 起點
            - via_point: 途經點
            - end_point: 終點
            - status: 狀態
            - driver_id: 司機ID
            - plate_number: 車牌號碼
            - category: 類別
            - base_fare: 基本車資
    
    返回:
        Flex Message 字典
    """
    # 格式化日期
    trip_date = trip_data.get('date')
    weekday_names = ["一", "二", "三", "四", "五", "六", "日"]
    weekday = weekday_names[trip_date.weekday()]
    formatted_date = f"{trip_date.month}/{trip_date.day} (星期{weekday})"
    
    # 格式化時間
    trip_time = trip_data.get('time')
    formatted_time = trip_time.strftime('%H:%M') if trip_time else '未設置'
    
    # 構建 Flex Message
    flex_message = {
        "type": "bubble",
        "header": {
            "type": "box",
            "layout": "vertical",
            "contents": [
                {
                    "type": "text",
                    "text": f"班次 #{trip_id} 詳細信息",
                    "weight": "bold",
                    "size": "xl",
                    "color": "#1DB446"
                }
            ],
            "backgroundColor": "#F2F2F2"
        },
        "body": {
            "type": "box",
            "layout": "vertical",
            "contents": [
                {
                    "type": "box",
                    "layout": "horizontal",
                    "contents": [
                        {
                            "type": "text",
                            "text": "日期",
                            "size": "sm",
                            "color": "#555555",
                            "flex": 2
                        },
                        {
                            "type": "text",
                            "text": formatted_date,
                            "size": "sm",
                            "color": "#111111",
                            "flex": 5
                        }
                    ]
                },
                {
                    "type": "box",
                    "layout": "horizontal",
                    "contents": [
                        {
                            "type": "text",
                            "text": "時間",
                            "size": "sm",
                            "color": "#555555",
                            "flex": 2
                        },
                        {
                            "type": "text",
                            "text": formatted_time,
                            "size": "sm",
                            "color": "#111111",
                            "flex": 5
                        }
                    ],
                    "margin": "md"
                },
                {
                    "type": "box",
                    "layout": "horizontal",
                    "contents": [
                        {
                            "type": "text",
                            "text": "起點",
                            "size": "sm",
                            "color": "#555555",
                            "flex": 2
                        },
                        {
                            "type": "text",
                            "text": trip_data.get('start_point') or '未指定',
                            "size": "sm",
                            "color": "#111111",
                            "flex": 5
                        }
                    ],
                    "margin": "md"
                }
            ]
        }
    }
    
    # 添加途經點（如果有）
    if trip_data.get('via_point'):
        flex_message["body"]["contents"].append({
            "type": "box",
            "layout": "horizontal",
            "contents": [
                {
                    "type": "text",
                    "text": "途經",
                    "size": "sm",
                    "color": "#555555",
                    "flex": 2
                },
                {
                    "type": "text",
                    "text": trip_data.get('via_point'),
                    "size": "sm",
                    "color": "#111111",
                    "flex": 5
                }
            ],
            "margin": "md"
        })
    
    # 添加終點
    flex_message["body"]["contents"].append({
        "type": "box",
        "layout": "horizontal",
        "contents": [
            {
                "type": "text",
                "text": "終點",
                "size": "sm",
                "color": "#555555",
                "flex": 2
            },
            {
                "type": "text",
                "text": trip_data.get('end_point') or '未指定',
                "size": "sm",
                "color": "#111111",
                "flex": 5
            }
        ],
        "margin": "md"
    })
    
    # 添加狀態
    status_color = {
        "待派": "#FF6B6E",
        "準備": "#6CD8A0",
        "取消": "#888888",
        "衝突": "#FF9153",
        "請假": "#A0A0FF",
        "完成": "#1DB446"
    }
    
    current_status = trip_data.get('status') or '未指定'
    flex_message["body"]["contents"].append({
        "type": "box",
        "layout": "horizontal",
        "contents": [
            {
                "type": "text",
                "text": "狀態",
                "size": "sm",
                "color": "#555555",
                "flex": 2
            },
            {
                "type": "text",
                "text": current_status,
                "size": "sm",
                "color": status_color.get(current_status, "#111111"),
                "weight": "bold",
                "flex": 5
            }
        ],
        "margin": "md"
    })
    
    # 添加司機信息
    if trip_data.get('driver_id'):
        flex_message["body"]["contents"].append({
            "type": "box",
            "layout": "horizontal",
            "contents": [
                {
                    "type": "text",
                    "text": "司機",
                    "size": "sm",
                    "color": "#555555",
                    "flex": 2
                },
                {
                    "type": "text",
                    "text": f"🚕{trip_data.get('driver_id')}",
                    "size": "sm",
                    "color": "#111111",
                    "flex": 5
                }
            ],
            "margin": "md"
        })
        
        if trip_data.get('plate_number'):
            flex_message["body"]["contents"].append({
                "type": "box",
                "layout": "horizontal",
                "contents": [
                    {
                        "type": "text",
                        "text": "車牌",
                        "size": "sm",
                        "color": "#555555",
                        "flex": 2
                    },
                    {
                        "type": "text",
                        "text": trip_data.get('plate_number'),
                        "size": "sm",
                        "color": "#111111",
                        "flex": 5
                    }
                ],
                "margin": "md"
            })
    else:
        flex_message["body"]["contents"].append({
            "type": "box",
            "layout": "horizontal",
            "contents": [
                {
                    "type": "text",
                    "text": "司機",
                    "size": "sm",
                    "color": "#555555",
                    "flex": 2
                },
                {
                    "type": "text",
                    "text": "未指派",
                    "size": "sm",
                    "color": "#111111",
                    "flex": 5
                }
            ],
            "margin": "md"
        })
    
    # 添加類別
    flex_message["body"]["contents"].append({
        "type": "box",
        "layout": "horizontal",
        "contents": [
            {
                "type": "text",
                "text": "類別",
                "size": "sm",
                "color": "#555555",
                "flex": 2
            },
            {
                "type": "text",
                "text": trip_data.get('category') or '未分類',
                "size": "sm",
                "color": "#111111",
                "flex": 5
            }
        ],
        "margin": "md"
    })
    
    # 添加基本車資（如果有）
    if trip_data.get('base_fare'):
        flex_message["body"]["contents"].append({
            "type": "box",
            "layout": "horizontal",
            "contents": [
                {
                    "type": "text",
                    "text": "基本車資",
                    "size": "sm",
                    "color": "#555555",
                    "flex": 2
                },
                {
                    "type": "text",
                    "text": f"{trip_data.get('base_fare')} 元",
                    "size": "sm",
                    "color": "#111111",
                    "flex": 5
                }
            ],
            "margin": "md"
        })
    
    # 添加分隔線
    flex_message["body"]["contents"].append({
        "type": "separator",
        "margin": "xxl"
    })
    
    # 添加狀態修改提示
    flex_message["body"]["contents"].append({
        "type": "box",
        "layout": "vertical",
        "contents": [
            {
                "type": "text",
                "text": "修改狀態",
                "weight": "bold",
                "size": "sm",
                "margin": "md",
                "color": "#1DB446"
            }
        ],
        "margin": "md"
    })
    
    # 添加狀態按鈕
    button_order = ["取消", "衝突", "請假"]
    status_buttons = []
    
    # 為每個狀態創建按鈕，除了當前狀態
    for status in button_order:
        if status != current_status:
            status_buttons.append({
                "type": "button",
                "action": {
                    "type": "message",
                    "label": status,
                    "text": f"修改狀態 {trip_id} {status}"
                },
                "color": status_color.get(status, "#999999"),
                "style": "primary",
                "height": "sm",
                "margin": "sm"
            })
    
    # 將按鈕放在一行
    if status_buttons:
        flex_message["body"]["contents"].append({
            "type": "box",
            "layout": "horizontal",
            "contents": status_buttons,
            "margin": "md"
        })
    
    return flex_message

if __name__ == "__main__":
    # 測試代碼
    from datetime import datetime, date
    
    test_data = {
        'date': date(2025, 3, 17),
        'time': datetime.strptime('09:50', '%H:%M').time(),
        'start_point': '仁和路',
        'via_point': None,
        'end_point': '診所',
        'status': '準備',
        'driver_id': '533',
        'plate_number': '留空後補',
        'category': '診所',
        'base_fare': 220
    }
    
    import json
    print(json.dumps(get_trip_details_flex('646', test_data), indent=2, ensure_ascii=False)) 